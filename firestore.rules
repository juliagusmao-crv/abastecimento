rules_version = '2';
// Regras do banco do site Abastecimento da Frota.
// Troque EMAIL_DA_ADMINISTRADORA pelo seu e-mail (o mesmo que você vai usar para entrar no site).
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function temPerfil() { return logado() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)); }
    function perfil() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function ativo() { return temPerfil() && perfil().status == 'ativo'; }
    function admin() { return ativo() && perfil().funcao == 'admin'; }

    match /usuarios/{uid} {
      allow read: if admin() || (logado() && request.auth.uid == uid);
      // primeiro acesso: só a administradora cria o próprio perfil
      allow create: if admin() || (logado() && request.auth.uid == uid
                      && request.auth.token.email == 'EMAIL_DA_ADMINISTRADORA'
                      && request.resource.data.funcao == 'admin');
      allow update, delete: if admin();
    }
    match /frentes/{id} {
      allow read: if ativo();
      allow write: if admin();
      // qualquer usuário ativo pode trocar só a fazenda (fica registrado quem trocou)
      allow update: if ativo() && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['fazenda', 'fazendaAlteradaPor', 'fazendaAlteradaEm']);
    }
    match /frotas/{id}  { allow read: if ativo(); allow write: if admin(); }
    match /registros/{id} {
      allow read: if ativo();
      allow create, update: if ativo();
      // lançamentos não são apagados: correções e anulações ficam guardadas
      allow delete: if false;
    }
    // registro de todas as correções, anulações e trocas de fazenda: ninguém apaga nem altera
    match /alteracoes/{id} {
      allow create: if ativo() && request.resource.data.usuarioId == request.auth.uid;
      allow read: if admin();
      allow update, delete: if false;
    }
    // texto original de cada "Importar mensagem", para auditoria
    match /importacoes/{id} {
      allow create: if ativo() && request.resource.data.usuarioId == request.auth.uid;
      allow read: if admin();
      allow update, delete: if false;
    }
  }
}
